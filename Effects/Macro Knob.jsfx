// @description Macro Knob
// @version 0.1.0
// @author Mannix Squared
// @provides ../LICENSE > Macro Knob-LICENSE.txt
// @link https://github.com/mannixsquared/JSFX
// @about
//   Macro controller for REAPER parameter links. Audio and MIDI pass through unchanged.
//   Charcoal and amber procedural interface with Retina scaling.
//   Requires REAPER 6.74 or later.
// @changelog
//   Initial release with the shared charcoal and amber interface.
// SPDX-License-Identifier: GPL-3.0-or-later
// Copyright (C) 2026 Mannix Squared
desc:Macro Knob (parameter link source)
slider1:0.5<0,1,0.001>-Macro
// REAPER 6.74+ for explicit automation touch release.
// Audio and MIDI pass through unchanged.

options:no_meter

@init
gfx_ext_retina=1;
dragging = 0;
previous_left = 0;

@gfx 360 420
// Procedural drawing vocabulary shared visually with ReaCrusher.
function ink(r,g,b) (gfx_set(r,g,b,1););
function text(x,y,size,str) (
  gfx_setfont(1,"Arial",max(8,size*ui_scale));
  gfx_x=ox+x*ui_scale; gfx_y=oy+y*ui_scale; gfx_drawstr(str);
);
function centered(x,y,w,size,str) local(tw,th) (
  gfx_setfont(1,"Arial",max(8,size*ui_scale));
  gfx_measurestr(str,tw,th);
  gfx_x=ox+(x+w*0.5)*ui_scale-tw*0.5; gfx_y=oy+y*ui_scale;
  gfx_drawstr(str);
);
function line(x,y,x2,y2) (
  gfx_line(ox+x*ui_scale,oy+y*ui_scale,ox+x2*ui_scale,oy+y2*ui_scale,1);
);
function box(x,y,w,h) (
  gfx_rect(ox+x*ui_scale,oy+y*ui_scale,w*ui_scale,h*ui_scale);
);
function circle(x,y,r,fill) (
  gfx_circle(ox+x*ui_scale,oy+y*ui_scale,r*ui_scale,fill,1);
);
function notify(id,value,low,high) local(mask) (
  value=max(low,min(high,value));
  value!=slider(id) ? (
    slider(id)=value; mask=2^(id-1);
    sliderchange(mask); slider_automate(mask); changed_mask|=mask;
  );
);
function dial(x,y,r,value,highlight) local(i,a,angle) (
  i=0;
  loop(31,
    a=(0.75+i/30*1.5)*$pi;
    i/30<=value ? ink(0.96,0.66,0.30) : ink(0.26,0.28,0.29);
    line(x+cos(a)*r*34/28,y+sin(a)*r*34/28,
         x+cos(a)*r*38/28,y+sin(a)*r*38/28);
    i+=1;
  );
  ink(0.065,0.073,0.08); circle(x,y+2*r/28,r+1,1);
  highlight ? ink(0.28,0.30,0.31) : ink(0.20,0.22,0.23);
  circle(x,y,r,1);
  ink(0.12,0.14,0.15); circle(x,y,r*23/28,0);
  ink(1,0.79,0.48); angle=(0.75+value*1.5)*$pi;
  line(x+cos(angle)*r*13/28,y+sin(angle)*r*13/28,
       x+cos(angle)*r*24/28,y+sin(angle)*r*24/28);
);

ui_scale=max(0.01,min(gfx_w/360,gfx_h/420));
ox=(gfx_w-360*ui_scale)/2; oy=(gfx_h-420*ui_scale)/2;
mx=(mouse_x-ox)/ui_scale; my=(mouse_y-oy)/ui_scale;
gfx_getchar();
left=mouse_cap&1; right=mouse_cap&2;
hover=(mx-180)^2+(my-218)^2<=86^2;
changed_mask=0;
left && !previous_left && hover ? (
  time_precise()-last_click<0.3 && last_click>0 ? (
    notify(1,0.5,0,1); slider_automate(slider1,1); sliderchange(-1);
    dragging=0;
  ) : (dragging=1; last_y=my;);
  last_click=time_precise();
);
dragging && left ? (
  notify(1,slider1+(last_y-my)*((mouse_cap&8) ? 0.0005 : 0.005),0,1);
  last_y=my;
  changed_mask ? gesture_changed=1;
);
dragging && !left ? (
  slider_automate(slider1,1);
  gesture_changed ? sliderchange(-1);
  dragging=0; gesture_changed=0;
);
hover && mouse_wheel!=0 ? (
  notify(1,slider1+mouse_wheel/120*((mouse_cap&8) ? 0.001 : 0.01),0,1);
  slider_automate(slider1,1); changed_mask ? sliderchange(-1);
);
right && !previous_right && hover ? (
  notify(1,0.5,0,1); slider_automate(slider1,1); changed_mask ? sliderchange(-1);
);
mouse_wheel=0; previous_left=left; previous_right=right;

gfx_clear=0;
ink(0.095,0.11,0.12); box(0,0,360,420);
ink(0.96,0.66,0.30); box(26,25,4,31);
ink(0.94,0.93,0.88); text(42,21,27,"Macro Knob");
ink(0.55,0.59,0.59); text(43,54,11,"PARAMETER CONTROLLER");
ink(0.25,0.28,0.29); line(26,87,334,87);
ink(0.94,0.93,0.88); text(26,106,15,"01  MACRO");
value=max(0,min(1,slider1));
dial(180,218,56,value,hover||dragging);
ink(0.88,0.88,0.85); centered(80,311,200,13,"Macro");
sprintf(#readout,"%.1f %%",value*100);
ink(0.60,0.63,0.63); centered(80,331,200,15,#readout);
ink(0.52,0.56,0.56);
centered(26,363,308,11,"DRAG / WHEEL   |   SHIFT: FINE");
ink(0.25,0.28,0.29); line(26,389,334,389);
ink(0.52,0.55,0.55); centered(26,400,308,10,"DOUBLE-CLICK / RIGHT-CLICK: RESET");
